msgstr "机器人 / 系统"

msgid "QQ group number, 5–11 digits."
msgstr "QQ 群号，5–11 位数字。"

msgid "The name members see."
msgstr "显示给成员看的名字。"

msgid ""
"Fixed group: any member can join. Role group: only people in the AA groups "
"selected below can join."
msgstr "固定群：所有成员都可以加入。身份组小群：只有下面所选 AA 组里的人可以加入。"

