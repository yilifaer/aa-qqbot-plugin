msgid ""
"Enter the verification code <strong class=\"font-"
"monospace\">%(code)s</strong> as the verification message and send the "
"request."
msgstr "在「验证信息」里填验证码 <strong class=\"font-monospace\">%(code)s</strong>，发送。"

msgid ""
"Enter the verification code as the verification message and send the "
"request."
msgstr "在「验证信息」里填验证码，发送。"

