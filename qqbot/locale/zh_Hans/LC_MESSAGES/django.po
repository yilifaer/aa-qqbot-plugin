msgid ""
"Leave empty to generate it from the format in Settings. At most "
"%(max_bytes)s bytes (a Chinese character takes 3 bytes)."
msgstr "留空表示按设置里的格式自动生成。最多 %(max_bytes)s 字节（一个汉字占 3 字节）。"

