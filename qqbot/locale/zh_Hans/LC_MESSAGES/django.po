msgctxt "qqbot"
msgid "Main character"
msgstr "主角色"

msgid "QQ binding"
msgstr "QQ 绑定"

msgid "QQ Admin"
msgstr "QQ 管理"

msgid "This QQ is already bound. If you have questions, contact a QQ admin."
msgstr "该 QQ 已被绑定，如有疑问请联系 QQ 管理员。"

msgid ""
"This member's QQ has just changed, so this page is out of date. Reopen the "
"page and check again before you continue."
msgstr "这个成员的 QQ 刚刚变了，页面上的信息已经过时。请重新打开页面核对后再操作。"

#, python-format
msgid "%(count)d hour"
msgid_plural "%(count)d hours"
msgstr[0] "%(count)d 小时"

#, python-format
msgid "%(count)d minute"
msgid_plural "%(count)d minutes"
msgstr[0] "%(count)d 分钟"

msgid "Enter a valid QQ number (5–11 digits, not starting with 0)."
msgstr "请输入正确的 QQ 号（5–11 位数字，不能以 0 开头）。"

msgid "Nothing to change."
msgstr "没有需要修改的内容。"

msgid "Nickname updated."
msgstr "昵称已更新。"

#, python-format
msgid "You changed your QQ too recently. Try again in %(time)s."
msgstr "换绑太频繁，请在 %(time)s后再试。"

#, python-format
msgid ""
"Too many binds or QQ changes (at most %(limit)d per hour). Please try again "
"later."
msgstr "绑定或换绑太频繁（每小时最多 %(limit)d 次），请稍后再试。"

#, python-format
msgid ""
"Too many verification codes requested (at most %(limit)d per hour). Please "
"try again later."
msgstr "生成验证码太频繁（每小时最多 %(limit)d 次），请稍后再试。"

msgid ""
"Before the code expires, request to join a QQ group and enter the "
"verification code as the verification message."
msgstr "请在有效期内申请加入 QQ 群，并在「验证信息」里填写验证码。"

msgid "Another account has also claimed this QQ. Please contact a QQ admin."
msgstr "这个 QQ 同时被其他账号认领，请联系 QQ 管理员处理。"

msgid "Bound (trusted: already in group)."
msgstr "绑定成功（老成员免验证）。"

msgid "Binding not found."
msgstr "绑定不存在。"

msgid "This binding is already verified."
msgstr "该绑定已经是已验证状态。"

msgid ""
"This QQ is already verified by another account and cannot be confirmed."
msgstr "该 QQ 已被其他账号验证，不能确认。"

msgid "Binding confirmed."
msgstr "已确认绑定。"

msgid "No QQ is bound."
msgstr "没有绑定 QQ。"

msgid "Unbound."
msgstr "已解除绑定。"

#, python-format
msgid ""
"Group nickname is too long: at most %(max)d bytes (a Chinese character takes"
" 3 bytes)."
msgstr "群名片太长：最多 %(max)d 字节（一个汉字占 3 字节）。"

msgid "Automatic group nickname restored."
msgstr "已恢复自动群名片。"

msgid "Group nickname set."
msgstr "群名片已设置。"

msgid "Invalid nickname."
msgstr "昵称格式不正确。"

msgid "Please enter a nickname."
msgstr "请填写昵称。"

#, python-format
msgid "Nickname can be at most %(max)d characters."
msgstr "昵称最长 %(max)d 个字。"

msgid "Nickname cannot contain two spaces in a row."
msgstr "昵称中不能有连续的空格。"

msgid ""
"Nickname can only contain Chinese characters, letters, digits, spaces and _ "
"- . · ( )."
msgstr "昵称只能包含中文、英文字母、数字、空格和 _ - . · ( )。"

msgid "Enter 5–11 digits (not starting with 0)."
msgstr "请输入 5–11 位数字（不能以 0 开头）。"

msgid "Group rules"
msgstr "入群须知"

msgid "Group nickname format"
msgstr "群名片格式"

#, python-brace-format
msgid ""
"Placeholders: {corp_ticker} corporation ticker, {alliance_ticker} alliance "
"ticker, {character_name} main character name, {nickname} nickname"
msgstr ""
"可用占位符：{corp_ticker} 军团简称、{alliance_ticker} 联盟简称、{character_name} "
"主角色名、{nickname} 昵称"

msgid "Verification code lifetime (minutes)"
msgstr "验证码有效期（分钟）"

msgid "Member list max age (days)"
msgstr "群成员名单有效期（天）"

msgid ""
"If the bot has not reported a group's member list for this many days, that "
"group no longer counts for \"Trusted (already in group)\"."
msgstr "机器人超过这么多天没有上报某个群的成员名单，该群就不能再用于「老成员免验证」。"

msgid "Trusted binding window (days)"
msgstr "老成员免验证过渡期（天）"

msgid ""
"Members already in a group can bind without a verification code only during "
"this many days after the group was added here. After that, everyone uses a "
"code. 0 turns this off."
msgstr "群添加到这里之后的这么多天内，已经在群里的老成员可以不用验证码直接绑定；过了这段时间，所有人都要用验证码。填 0 表示关闭。"

msgid "Change QQ cooldown (hours)"
msgstr "换绑冷却（小时）"

msgid "Settings"
msgstr "设置"

msgid "QQ binding settings"
msgstr "QQ 绑定设置"

msgid "Fixed group"
msgstr "固定群"

msgid "Role group"
msgstr "身份组小群"

msgid "Group name"
msgstr "群名称"

msgid "Group number"
msgstr "群号"

msgid "Type"
msgstr "类型"

msgid "Required AA groups"
msgstr "需要的 AA 组"

msgid "Only for role groups: being in any one of these groups is enough."
msgstr "只对身份组小群有效：属于其中任意一个组即可。"

